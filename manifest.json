{
  "manifest_version": 3,
  "name": "QuickBooks Overhead Fee",
  "version": "1.3",
  "description": "Adds a configurable overhead fee line item to QuickBooks invoices",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://qbo.intuit.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QB Overhead Fee"
  },
  "content_scripts": [
    {
      "matches": ["https://qbo.intuit.com/app/invoice*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}